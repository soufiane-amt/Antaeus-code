# Copy this file to .env and fill in your key:  cp .env.example .env
# Only OPENROUTER_API_KEY is required; everything else has a default.

# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Any Anthropic-compatible Messages API endpoint.
API_BASE_URL=https://openrouter.ai/api

# Model the agent runs on (any OpenRouter model id that supports tool use).
# For a free model, try minimax/minimax-m3.1-flash:free
PRIMARY_MODEL=anthropic/claude-sonnet-5.5

# Smaller model for helper tasks: web search and summarizing fetched pages.
CHEAP_MODEL=qwen/qwen3-4b

# Model that summarizes the conversation when it nears the context window.
# Defaults to PRIMARY_MODEL.
# COMPACT_MODEL=anthropic/claude-sonnet-5.5

# Maximum tokens per reply. Too low and replies get cut off mid-sentence.
# OpenRouter rejects a request if your balance can't cover this many tokens,
# so lower it if you're running on a small balance.
MAX_TOKENS=32000

# PRIMARY_MODEL's context window in tokens. The conversation is summarized at 80% of it.
CONTEXT_WINDOW=200000

# Safety limits for a single request: model calls and tool calls.
MAX_ITERATIONS=30
MAX_TOOL_CALLS=50

# Seconds a shell command may run before it's stopped.
COMMAND_TIMEOUT=30
